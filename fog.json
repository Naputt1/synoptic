{
  "$schema": "https://raw.githubusercontent.com/Naputt1/fog/main/fog.schema.json",
  "project": {
    "icon": "\u25c6"
  },
  "dnsmasq": {
    "domains": ["synoptic"]
  },
  "router": {
    "hostname": "router.synoptic",
    "dashboard_port": 8080,
    "shared_network": "fog-router"
  },
  "native_routes": [
    {
      "host": "synoptic.localhost",
      "service": "ui",
      "port": "${ports.dev}"
    },
    {
      "host": "${branch}.synoptic",
      "service": "ui",
      "port": "${ports.dev}"
    }
  ],
  "ports": {
    "dev": 0,
    "page": 0
  },
  "scripts": {
    "dev": {
      "service": [
        {
          "name": "ui",
          "path": ".",
          "cmd": "ROOT=$SYN_REPO; [ -n \"$ROOT\" ] || ROOT=$HOME/git/Resm; go run . -root \"$ROOT\" -json ui/public/synoptic.json -html=false && npm --prefix ui run dev -- --host 0.0.0.0 --port ${ports.dev} --strictPort",
          "health_check": {
            "kind": "tcp",
            "target": "127.0.0.1:${ports.dev}",
            "start_period_ms": 20000,
            "interval_ms": 3000,
            "timeout_ms": 2000
          }
        }
      ]
    },
    "page": {
      "service": [
        {
          "name": "page",
          "path": ".",
          "cmd": "ROOT=$SYN_REPO; [ -n \"$ROOT\" ] || ROOT=$HOME/git/Resm; npm --prefix ui run build && go run . -root \"$ROOT\" -out out/index.html && python3 -m http.server ${ports.page} --bind 0.0.0.0 --directory out",
          "health_check": {
            "kind": "tcp",
            "target": "127.0.0.1:${ports.page}",
            "start_period_ms": 45000,
            "interval_ms": 3000,
            "timeout_ms": 2000
          }
        }
      ]
    }
  }
}
